<?xml version="1.0" encoding="utf-8"?>
<!-- 右侧滑出：书签面板（本文书签 / 跨文档查找） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_bookmark"
    android:layout_width="310dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@drawable/bg_drawer_right"
    android:orientation="vertical"
    android:elevation="16dp"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/panel_bookmark_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:background="@color/paper_surface_variant">

        <TextView
            android:id="@+id/tv_panel_bookmark_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="书签"
            android:textColor="@color/paper_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle" />

        <ImageView
            android:id="@+id/btn_add_bookmark"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_bookmark_add"
            android:background="@drawable/bg_btn_icon"
            android:contentDescription="添加书签" />

        <ImageView
            android:id="@+id/btn_close_bookmark"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_btn_icon"
            android:contentDescription="关闭书签" />
    </LinearLayout>

    <View
        android:id="@+id/div_bookmark_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/paper_border" />

    <!-- 双 Tab：本文书签 / 文件夹查找 -->
    <LinearLayout
        android:id="@+id/layout_bookmark_tabs"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tab_bookmarks"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="本文书签"
            android:textColor="@color/paper_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_quick_key" />

        <TextView
            android:id="@+id/tab_folder_search"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="文件夹查找"
            android:textColor="@color/paper_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:id="@+id/div_bookmark_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/paper_border" />

    <!-- ===== 内容一：书签列表 ===== -->
    <LinearLayout
        android:id="@+id/layout_bookmark_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ListView
            android:id="@+id/list_bookmarks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/tv_empty_bookmarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="36dp"
            android:text="🍂 还没有书签\n点上方书签按钮，把当前位置夹在纸上"
            android:textColor="@color/paper_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== 内容二：文件夹内查找 ===== -->
    <LinearLayout
        android:id="@+id/layout_folder_search"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp">

            <EditText
                android:id="@+id/et_folder_search"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="在文件夹中查找…"
                android:textColor="@color/paper_text_primary"
                android:textColorHint="@color/paper_text_secondary"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/btn_do_folder_search"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="查找"
                android:textColor="@color/paper_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_quick_key" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <CheckBox
                android:id="@+id/cb_folder_recursive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="含子目录"
                android:textSize="12sp"
                android:textColor="@color/paper_text_secondary"
                android:buttonTint="@color/paper_accent" />

            <TextView
                android:id="@+id/tv_folder_search_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="@color/paper_text_secondary"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>

        <ListView
            android:id="@+id/list_folder_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/tv_empty_folder_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="30dp"
            android:text="输入关键词后点「查找」"
            android:textColor="@color/paper_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
