<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_paper"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/dlg_input_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:text="标题"
        android:textColor="@color/paper_accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/dlg_input_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_search_card"
        android:singleLine="true"
        android:textColor="@color/paper_text_primary"
        android:textColorHint="@color/paper_text_secondary"
        android:textSize="15sp"
        android:importantForAutofill="no"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/dlg_input_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="取消"
            android:textColor="@color/paper_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dlg_input_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="确定"
            android:textColor="@color/paper_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_quick_key" />
    </LinearLayout>

</LinearLayout>
