<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_file_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_paper_card"
    android:layout_marginBottom="7dp">

    <!-- 优雅的小图标徽标容器 -->
    <FrameLayout
        android:id="@+id/layout_icon_badge"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_quick_key">

        <ImageView
            android:id="@+id/iv_file_icon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_file_doc" />
    </FrameLayout>

    <!-- 文件详情 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/paper_text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tv_file_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/paper_text_secondary"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 右侧状态指示：如当前正在阅读的标记小圆点或箭头 -->
    <TextView
        android:id="@+id/tv_current_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="阅读中"
        android:textSize="10sp"
        android:textColor="@color/paper_accent"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/bg_quick_key"
        android:visibility="gone" />

</LinearLayout>