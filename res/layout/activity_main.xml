<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_bg">

    <!-- 全屏沉浸阅读器 WebView -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper_bg" />

    <!-- 页面右上角常驻阅读统计 (小字，素雅纸墨风格) -->
    <TextView
        android:id="@+id/tv_reading_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text=""
        android:textColor="@color/paper_text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.02"
        android:visibility="gone" />

    <!-- 全屏编辑器容器 (编辑模式时显示) -->
    <LinearLayout
        android:id="@+id/layout_edit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/paper_bg">

        <!-- 编辑模式顶栏 -->
        <LinearLayout
            android:id="@+id/edit_top_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@color/paper_surface"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tv_edit_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="编辑文稿"
                android:textColor="@color/paper_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/btn_edit_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="完成阅读"
                android:textColor="@color/paper_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_quick_key" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="20dp"
            android:gravity="top|start"
            android:background="@null"
            android:textColor="@color/paper_text_primary"
            android:textColorHint="@color/paper_text_secondary"
            android:hint="在此用素雅墨水书写..."
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:scrollbars="vertical"
            android:inputType="textMultiLine|textNoSuggestions" />

        <!-- 编辑模式 Markdown 快捷符号栏 -->
        <HorizontalScrollView
            android:id="@+id/edit_quick_scroll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/paper_surface"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_quick_symbols"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 顶部纸质风格标题栏 (点击屏幕中间时显现，默认隐藏) -->
    <LinearLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/paper_surface"
        android:elevation="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未命名文档"
                android:textColor="@color/paper_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="素笺纸质阅读"
                android:textColor="@color/paper_text_secondary"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧圆形悬浮轮盘菜单 (小巧精致版 170dp) -->
    <FrameLayout
        android:id="@+id/wheel_menu"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_wheel_circle"
        android:elevation="10dp"
        android:visibility="gone">

        <!-- 中心装饰微标：素笺 -->
        <TextView
            android:id="@+id/tv_wheel_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="素笺"
            android:textColor="@color/paper_text_secondary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- 1. 顶部偏上 (12点偏中): 目录 -->
        <LinearLayout
            android:id="@+id/btn_files_drawer"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <ImageView
                android:id="@+id/iv_folder_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_folder" />

            <TextView
                android:id="@+id/tv_drawer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="目录"
                android:textColor="@color/paper_text_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 2. 右上方 (2点方向): 大纲 -->
        <LinearLayout
            android:id="@+id/btn_outline"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <ImageView
                android:id="@+id/iv_outline_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_toc" />

            <TextView
                android:id="@+id/tv_outline_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="大纲"
                android:textColor="@color/paper_text_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 3. 右下方 (4点方向): 朗读 -->
        <LinearLayout
            android:id="@+id/btn_tts"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="25dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <ImageView
                android:id="@+id/iv_tts_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_speaker" />

            <TextView
                android:id="@+id/tv_tts_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="朗读"
                android:textColor="@color/paper_text_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 4. 正底部 (6点方向): 日夜间 -->
        <LinearLayout
            android:id="@+id/btn_theme_toggle"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="5dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <ImageView
                android:id="@+id/iv_theme_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_mode_night" />

            <TextView
                android:id="@+id/tv_theme_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="夜间"
                android:textColor="@color/paper_text_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 5. 左下方 (8点方向): 编辑 -->
        <LinearLayout
            android:id="@+id/btn_toggle_mode"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="25dp"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <ImageView
                android:id="@+id/iv_edit_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_edit" />

            <TextView
                android:id="@+id/tv_edit_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="编辑"
                android:textColor="@color/paper_text_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 6. 左上方 (10点方向): 保存 -->
        <LinearLayout
            android:id="@+id/btn_save"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="25dp"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <ImageView
                android:id="@+id/iv_save_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_save" />

            <TextView
                android:id="@+id/tv_save_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存"
                android:textColor="@color/paper_accent"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>

    <!-- 侧拉遮罩层 (半透明遮罩) -->
    <View
        android:id="@+id/mask_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- 左侧滑出：文稿目录面板 -->
    <LinearLayout
        android:id="@+id/panel_file_list"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="14dp">

        <!-- 抽屉顶部标题栏 -->
        <LinearLayout
            android:id="@+id/panel_file_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="12dp"
            android:background="@color/paper_surface_variant">

            <TextView
                android:id="@+id/tv_panel_file_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="文稿目录"
                android:textColor="@color/paper_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_change_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="切换目录"
                android:textColor="@color/paper_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_quick_key" />

            <ImageView
                android:id="@+id/btn_new_file"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_add"
                android:background="@drawable/bg_btn_icon"
                android:contentDescription="新建笔记" />
        </LinearLayout>

        <View
            android:id="@+id/div_drawer_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/paper_border" />

        <!-- 路径面包屑与返回上级条 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@color/paper_surface">

            <!-- 返回上一级轻按钮 -->
            <LinearLayout
                android:id="@+id/btn_go_up"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_quick_key"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_go_up_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 上级"
                    android:textColor="@color/paper_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_current_dir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/paper_text_secondary"
                android:textSize="11.5sp"
                android:singleLine="true"
                android:ellipsize="middle" />
        </LinearLayout>

        <View
            android:id="@+id/div_drawer_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/paper_border" />

        <!-- 列表容器 -->
        <ListView
            android:id="@+id/list_files"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tv_empty_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="🍃 该目录下暂无 Markdown 文档"
            android:textColor="@color/paper_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 右侧滑出：章节大纲面板 (TOC 右侧抽屉) -->
    <LinearLayout
        android:id="@+id/panel_outline"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_drawer_right"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="16dp">

        <LinearLayout
            android:id="@+id/panel_outline_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="12dp"
            android:background="@color/paper_surface_variant">

            <TextView
                android:id="@+id/tv_panel_outline_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="章节大纲"
                android:textColor="@color/paper_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_close_outline"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_btn_icon"
                android:contentDescription="关闭大纲" />
        </LinearLayout>

        <View
            android:id="@+id/div_outline_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/paper_border" />

        <ListView
            android:id="@+id/list_outline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:clipToPadding="false"
            android:divider="@color/paper_divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/tv_empty_outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="36dp"
            android:text="未发现标题（# 标题）"
            android:textColor="@color/paper_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>