<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_bg">

    <!-- 全屏沉浸阅读器 WebView -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper_bg" />

    <!-- 页面右上角常驻阅读统计 (小字，素雅纸墨风格) -->
    <TextView
        android:id="@+id/tv_reading_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text=""
        android:textColor="@color/paper_text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.02"
        android:visibility="gone" />

    <!-- 全屏编辑器容器 (编辑模式时显示) -->
    <LinearLayout
        android:id="@+id/layout_edit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/paper_bg">

        <!-- 编辑模式顶栏 -->
        <LinearLayout
            android:id="@+id/edit_top_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@color/paper_surface"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tv_edit_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="编辑文稿"
                android:textColor="@color/paper_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/btn_edit_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="完成阅读"
                android:textColor="@color/paper_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_quick_key" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="20dp"
            android:gravity="top|start"
            android:background="@null"
            android:textColor="@color/paper_text_primary"
            android:textColorHint="@color/paper_text_secondary"
            android:hint="在此用素雅墨水书写..."
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:scrollbars="vertical"
            android:inputType="textMultiLine|textNoSuggestions" />

        <!-- 编辑模式 Markdown 快捷符号栏 -->
        <HorizontalScrollView
            android:id="@+id/edit_quick_scroll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/paper_surface"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_quick_symbols"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 右侧圆形悬浮轮盘菜单 (紧凑版 154dp，6 格均分圆周) -->
    <FrameLayout
        android:id="@+id/wheel_menu"
        android:layout_width="154dp"
        android:layout_height="154dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_wheel_circle"
        android:elevation="10dp"
        android:visibility="gone">

        <!-- 中心装饰微标：素笺 -->
        <TextView
            android:id="@+id/tv_wheel_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="素笺"
            android:textColor="@color/paper_text_secondary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- 1. 顶部居中 (12点): 目录 -->
        <LinearLayout
            android:id="@+id/btn_files_drawer"
            android:layout_width="46dp"
            android:layout_height="40dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <ImageView
                android:id="@+id/iv_folder_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_folder" />

            <TextView
                android:id="@+id/tv_drawer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="目录"
                android:textColor="@color/paper_text_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 2. 右上 (2点): 搜索 -->
        <LinearLayout
            android:id="@+id/btn_search"
            android:layout_width="46dp"
            android:layout_height="40dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <ImageView
                android:id="@+id/iv_search_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search" />

            <TextView
                android:id="@+id/tv_search_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索"
                android:textColor="@color/paper_text_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 3. 右下 (4点): 大纲 -->
        <LinearLayout
            android:id="@+id/btn_outline"
            android:layout_width="46dp"
            android:layout_height="40dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <ImageView
                android:id="@+id/iv_outline_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_toc" />

            <TextView
                android:id="@+id/tv_outline_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="大纲"
                android:textColor="@color/paper_text_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 4. 底部居中 (6点): 书签 -->
        <LinearLayout
            android:id="@+id/btn_bookmark"
            android:layout_width="46dp"
            android:layout_height="40dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <FrameLayout
                android:layout_width="16dp"
                android:layout_height="16dp">

                <ImageView
                    android:id="@+id/iv_bookmark_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_bookmark" />

                <View
                    android:id="@+id/view_bookmark_dot"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_bookmark_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_bookmark_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="书签"
                android:textColor="@color/paper_text_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 5. 左下 (8点): 朗读 -->
        <LinearLayout
            android:id="@+id/btn_tts"
            android:layout_width="46dp"
            android:layout_height="40dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <ImageView
                android:id="@+id/iv_tts_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_speaker" />

            <TextView
                android:id="@+id/tv_tts_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="朗读"
                android:textColor="@color/paper_text_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 6. 左上 (10点): 更多（夜间 / 保存 / 编辑） -->
        <LinearLayout
            android:id="@+id/btn_more"
            android:layout_width="46dp"
            android:layout_height="40dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_icon">

            <ImageView
                android:id="@+id/iv_more_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_more" />

            <TextView
                android:id="@+id/tv_more_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更多"
                android:textColor="@color/paper_text_primary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 隐藏锚点控件：主题 / 编辑 / 保存由「更多」菜单统一调度 -->
        <LinearLayout
            android:id="@+id/btn_theme_toggle"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone">
            <ImageView android:id="@+id/iv_theme_icon" android:layout_width="1dp" android:layout_height="1dp" android:src="@drawable/ic_mode_night" />
            <TextView android:id="@+id/tv_theme_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="夜间" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_toggle_mode"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone">
            <ImageView android:id="@+id/iv_edit_icon" android:layout_width="1dp" android:layout_height="1dp" android:src="@drawable/ic_edit" />
            <TextView android:id="@+id/tv_edit_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="编辑" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_save"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone">
            <ImageView android:id="@+id/iv_save_icon" android:layout_width="1dp" android:layout_height="1dp" android:src="@drawable/ic_save" />
            <TextView android:id="@+id/tv_save_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="保存" />
        </LinearLayout>

    </FrameLayout>

    <!-- 顶部纤细纸签标题栏 (轻触屏幕中间时显现，默认隐藏) -->
    <LinearLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:background="@color/paper_surface"
        android:elevation="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未命名文档"
                android:textColor="@color/paper_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="素笺纸质阅读"
                android:textColor="@color/paper_text_secondary"
                android:textSize="10.5sp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_toggle_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="统计"
            android:textColor="@color/paper_accent"
            android:textSize="11.5sp"
            android:background="@drawable/bg_quick_key" />

        <!-- 顶栏书签按钮：一键把当前阅读位置加入书签 -->
        <ImageView
            android:id="@+id/btn_add_bookmark_top"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_bookmark_plus"
            android:background="@drawable/bg_btn_icon"
            android:contentDescription="加入书签" />
    </LinearLayout>

    <!-- 下拉搜索卡片（从顶栏下方展开） -->
    <include
        android:id="@+id/layout_search_card"
        layout="@layout/layout_search_card" />

    <!-- 右侧滑出：书签面板 -->
    <include
        android:id="@+id/panel_bookmark_include"
        layout="@layout/panel_bookmark" />

    <!-- 侧拉遮罩层 (半透明遮罩) -->
    <View
        android:id="@+id/mask_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- 左侧滑出：文稿目录面板 -->
    <LinearLayout
        android:id="@+id/panel_file_list"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="14dp">

        <!-- 抽屉顶部标题栏 -->
        <LinearLayout
            android:id="@+id/panel_file_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="12dp"
            android:background="@color/paper_surface_variant">

            <TextView
                android:id="@+id/tv_panel_file_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="文稿目录"
                android:textColor="@color/paper_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_file_search"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/ic_search"
                android:background="@drawable/bg_btn_icon"
                android:contentDescription="搜索文档" />

            <ImageView
                android:id="@+id/btn_new_file"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_add"
                android:background="@drawable/bg_btn_icon"
                android:contentDescription="新建笔记" />
        </LinearLayout>

        <View
            android:id="@+id/div_drawer_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/paper_border" />

        <!-- 文档搜索条（点标题栏放大镜展开） -->
        <LinearLayout
            android:id="@+id/layout_file_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:background="@color/paper_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_search"
                    android:alpha="0.55"
                    android:contentDescription="搜索" />

                <EditText
                    android:id="@+id/et_file_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="搜索文件名，跨文件夹查找…"
                    android:textColor="@color/paper_text_primary"
                    android:textColorHint="@color/paper_text_secondary"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:importantForAutofill="no" />

                <ImageView
                    android:id="@+id/btn_file_search_close"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/bg_btn_icon"
                    android:contentDescription="关闭搜索" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <CheckBox
                    android:id="@+id/cb_file_recursive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="含子目录"
                    android:textSize="12sp"
                    android:textColor="@color/paper_text_secondary"
                    android:buttonTint="@color/paper_accent" />

                <CheckBox
                    android:id="@+id/cb_file_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="搜正文"
                    android:textSize="12sp"
                    android:textColor="@color/paper_text_secondary"
                    android:buttonTint="@color/paper_accent" />

                <TextView
                    android:id="@+id/tv_file_search_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text=""
                    android:textColor="@color/paper_text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 路径面包屑与返回上级条 -->
        <LinearLayout
            android:id="@+id/layout_file_breadcrumb"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@color/paper_surface">

            <!-- 返回上一级轻按钮 -->
            <LinearLayout
                android:id="@+id/btn_go_up"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_quick_key"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_go_up_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ 上级"
                    android:textColor="@color/paper_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_current_dir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/paper_text_secondary"
                android:textSize="11.5sp"
                android:singleLine="true"
                android:ellipsize="middle" />
        </LinearLayout>

        <View
            android:id="@+id/div_drawer_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/paper_border" />

        <!-- 列表容器 -->
        <ListView
            android:id="@+id/list_files"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tv_empty_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="🍃 该目录下暂无 Markdown 文档"
            android:textColor="@color/paper_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 右侧滑出：章节大纲面板 (TOC 右侧抽屉) -->
    <LinearLayout
        android:id="@+id/panel_outline"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_drawer_right"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="16dp">

        <LinearLayout
            android:id="@+id/panel_outline_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="12dp"
            android:background="@color/paper_surface_variant">

            <TextView
                android:id="@+id/tv_panel_outline_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="章节大纲"
                android:textColor="@color/paper_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_close_outline"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_btn_icon"
                android:contentDescription="关闭大纲" />
        </LinearLayout>

        <View
            android:id="@+id/div_outline_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/paper_border" />

        <ListView
            android:id="@+id/list_outline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:clipToPadding="false"
            android:divider="@color/paper_divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/tv_empty_outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="36dp"
            android:text="未发现标题（# 标题）"
            android:textColor="@color/paper_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>