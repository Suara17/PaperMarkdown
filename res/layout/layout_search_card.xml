<?xml version="1.0" encoding="utf-8"?>
<!-- 下拉搜索卡片：从顶栏下方展开，紧凑单行 + 结果计数 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="60dp"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/bg_search_card"
    android:elevation="12dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="7dp"
            android:src="@drawable/ic_search"
            android:alpha="0.6"
            android:contentDescription="搜索" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="在本文中搜索…"
            android:textColor="@color/paper_text_primary"
            android:textColorHint="@color/paper_text_secondary"
            android:textSize="15sp"
            android:singleLine="true"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/tv_search_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="6dp"
            android:text=""
            android:textColor="@color/paper_text_secondary"
            android:textSize="11.5sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/btn_search_up"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_up"
            android:background="@drawable/bg_btn_icon"
            android:contentDescription="上一处" />

        <ImageView
            android:id="@+id/btn_search_down"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_down"
            android:background="@drawable/bg_btn_icon"
            android:contentDescription="下一处" />

        <ImageView
            android:id="@+id/btn_search_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_btn_icon"
            android:contentDescription="关闭搜索" />
    </LinearLayout>

</LinearLayout>
